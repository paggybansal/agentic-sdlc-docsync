# ---------------------------------------------------------------
# docsync configuration — copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------

# GitHub repository to read metadata from, format: owner/repo
DOCSYNC_GITHUB_REPO=parag-bansal/agentic-sdlc-docsync

# Optional. Personal Access Token with PUBLIC read scope only.
# Leave EMPTY to run docsync in offline mode (API fields render as "Not Found").
DOCSYNC_GITHUB_TOKEN=

# Optional. Request timeout in seconds.
DOCSYNC_HTTP_TIMEOUT=5
# verified by hook smoke test